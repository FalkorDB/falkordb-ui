# Required
OPENAI_API_KEY=sk-...

# Support email destination
SUPPORT_EMAIL=support@falkordb.com

# SendGrid (option 1 — preferred)
SENDGRID_API_KEY=SG...

# SMTP fallback (option 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@falkordb.com

# FalkorDB (defaults work inside Docker)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Default graph name
DEFAULT_GRAPH=falkordb-docs

# CORS — comma-separated allowed origins
CORS_ORIGINS=https://falkordb.com,https://docs.falkordb.com

# Optional
SESSION_TTL_SECONDS=3600
FASTAPI_DEBUG=false
