{
  "name": "@falkordb/graphrag-widget",
  "version": "0.1.0",
  "description": "Embeddable chat widget powered by FalkorDB GraphRAG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FalkorDB/falkordb-ui",
    "directory": "web-components/graphrag-widget"
  },
  "keywords": ["falkordb", "chat", "widget", "graphrag", "knowledge-graph"],
  "main": "dist/falkordb-chat.mjs",
  "module": "dist/falkordb-chat.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/falkordb-chat.iife.js",
  "jsdelivr": "dist/falkordb-chat.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/falkordb-chat.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "^10.19.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.8",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
