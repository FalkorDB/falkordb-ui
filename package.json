{
	"name": "@falkordb/ui",
	"version": "0.1.1",
	"description": "The shared FalkorDB design system — themeable React primitives built on Radix UI and Tailwind CSS.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FalkorDB/falkordb-ui.git"
	},
	"homepage": "https://github.com/FalkorDB/falkordb-ui#readme",
	"bugs": {
		"url": "https://github.com/FalkorDB/falkordb-ui/issues"
	},
	"keywords": [
		"falkordb",
		"design-system",
		"react",
		"radix-ui",
		"tailwindcss",
		"components"
	],
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./styles.css": "./dist/styles.css",
		"./theme.css": "./dist/theme.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "npm run build:js && npm run build:css",
		"build:js": "vite build",
		"build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify && cpy src/theme/theme.css dist --flat",
		"dev": "vite build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"peerDependencies": {
		"react": "^18.3.0 || ^19.0.0",
		"react-dom": "^18.3.0 || ^19.0.0"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.1.4",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-select": "^2.1.6",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-switch": "^1.1.3",
		"@radix-ui/react-tabs": "^1.1.3",
		"@radix-ui/react-toast": "^1.2.6",
		"@radix-ui/react-tooltip": "^1.1.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.475.0",
		"tailwind-merge": "^3.0.1",
		"tw-animate-css": "^1.2.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@storybook/addon-a11y": "^8.6.14",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/react": "^8.6.14",
		"@storybook/react-vite": "^8.6.14",
		"@tailwindcss/cli": "^4.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.6",
		"@types/node": "^22.13.5",
		"@types/react": "^19.0.10",
		"@types/react-dom": "^19.0.4",
		"@vitejs/plugin-react": "^4.7.0",
		"@vitest/coverage-v8": "^3.2.7",
		"cpy-cli": "^5.0.0",
		"eslint": "^9.21.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-storybook": "^0.11.3",
		"jsdom": "^29.1.1",
		"prettier": "^3.5.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"storybook": "^8.6.14",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.25.0",
		"vite": "^6.2.0",
		"vite-plugin-dts": "^4.5.0",
		"vitest": "^3.2.7"
	},
	"engines": {
		"node": ">=20"
	}
}
